# Model: aceleași nume se pun în Vercel → Settings → Environment Variables.
# Nu scrieți valorile reale aici. Acest fișier ajunge pe GitHub.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789
# Opțional: doar aceste emailuri pot intra în panou (despărțite prin virgulă)
ADMIN_EMAILS=
# Tema 2
# Cheia Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...
# Cheia Google Gemini (aistudio.google.com → Get API key)
GEMINI_API_KEY=...
# Opțional: câte imagini pe zi poate genera un utilizator (implicit 5)
IMAGINI_PE_ZI=5
